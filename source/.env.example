# Copy to .env.local and fill in. Baked into the build as the default Genius token.
MAIN_VITE_GENIUS_TOKEN=

# Last.fm scrobbling: create an API account at https://www.last.fm/api/account/create
MAIN_VITE_LASTFM_KEY=
MAIN_VITE_LASTFM_SECRET=

# Pulse profiles and badges: the address install.sh prints (see server/README.md)
MAIN_VITE_PULSE_SERVER=
