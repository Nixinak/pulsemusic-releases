{
  "name": "pulse-music",
  "productName": "Pulse Music",
  "version": "1.6.3",
  "description": "A liquid-glass desktop client for Spotify",
  "author": "Nix.gg",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch:llama": "node scripts/fetch-llama.cjs",
    "dist": "node scripts/fetch-cloudflared.cjs && node scripts/fetch-llama.cjs && electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "release": "node scripts/fetch-cloudflared.cjs && node scripts/fetch-llama.cjs && electron-vite build && electron-builder --win --config electron-builder.yml --config.directories.output=release --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "evs:setup": "py -3 -m pip install --upgrade castlabs-evs && py -3 -m castlabs_evs.account signup",
    "evs:sign-dev": "py -3 -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "evs:login": "py -3 -m castlabs_evs.account reauth"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@huggingface/transformers": "^3.8.1",
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-updater": "^6.6.2",
    "kokoro-js": "^1.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/figtree": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "https://github.com/castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "motion": "^14.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "zustand": "^5.0.0"
  }
}
