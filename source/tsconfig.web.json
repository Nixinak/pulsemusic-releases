{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["spotify-web-playback-sdk", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/src/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/shared/**/*"]
}
